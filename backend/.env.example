# IntelliSum backend settings. Copy to `backend/.env` and uncomment what you want to change.
# Every setting can also be given as an environment variable with the same name.
# Defaults are shown; see app/config.py for full explanations.

# --- Server -----------------------------------------------------------------
# INTELLISUM_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'
# INTELLISUM_MAX_CONCURRENT_JOBS=1          # background jobs running at once (1 suits CPU)

# --- Input limits -------------------------------------------------------------
# INTELLISUM_MAX_UPLOAD_MB=10
# INTELLISUM_MAX_INPUT_CHARS=500000
# INTELLISUM_MIN_INPUT_WORDS=40
# INTELLISUM_MIN_INPUT_SENTENCES=3
# INTELLISUM_ABSTRACTIVE_MAX_INPUT_WORDS=20000   # longer input -> use Hybrid

# --- Preprocessing --------------------------------------------------------------
# INTELLISUM_SPACY_MODEL=en_core_web_sm
# INTELLISUM_SENTENCE_SEGMENTER=parser       # parser | senter | rule
# INTELLISUM_MIN_SENTENCE_WORDS=3

# --- Summary length (fraction of the input) -------------------------------------
# INTELLISUM_LENGTH_RATIOS='{"short": 0.12, "medium": 0.22, "long": 0.32}'

# --- Extractive methods -----------------------------------------------------------
# INTELLISUM_REDUNDANCY_THRESHOLD=0.8        # skip sentences more similar than this to a chosen one
# INTELLISUM_TEXTRANK_DAMPING=0.85
# INTELLISUM_TEXTRANK_SIMILARITY_THRESHOLD=0.05
# INTELLISUM_TEXTRANK_MAX_NEIGHBORS=50

# --- Abstractive model --------------------------------------------------------------
# INTELLISUM_ABSTRACTIVE_MODEL_NAME=facebook/bart-large-cnn
# INTELLISUM_DEVICE=auto                     # auto | cpu | cuda (auto uses the GPU only if it actually works)
# INTELLISUM_USE_FP16=false                  # half precision on GPU
# INTELLISUM_NUM_BEAMS=4
# INTELLISUM_LENGTH_PENALTY=2.0
# INTELLISUM_NO_REPEAT_NGRAM_SIZE=3
# INTELLISUM_MIN_SUMMARY_TOKENS=20
# INTELLISUM_MAX_SUMMARY_TOKENS=400
# INTELLISUM_TOKENS_PER_WORD=1.3

# --- Long documents -------------------------------------------------------------------
# INTELLISUM_CHUNK_MAX_TOKENS=900
# INTELLISUM_CHUNK_OVERLAP_SENTENCES=0
# INTELLISUM_CHUNKING_STRATEGY=sentence      # sentence | recursive (LangChain RecursiveCharacterTextSplitter)
# INTELLISUM_MAX_REDUCTION_LEVELS=3

# --- Hybrid ---------------------------------------------------------------------------
# INTELLISUM_HYBRID_EXPANSION=3.0            # TextRank selects this many times the summary length

# --- Experimental faithfulness check ----------------------------------------------------
# INTELLISUM_FAITHFULNESS_CHECK=true
# INTELLISUM_FAITHFULNESS_MIN_COVERAGE=0.6
